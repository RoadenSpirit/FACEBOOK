# ==============================================================================
# Facebook Scraper & Report Generator — Variables de Entorno
# ==============================================================================

# Ruta al archivo JSON con cookies de sesión de Facebook exportadas
FACEBOOK_COOKIES_PATH=./cookies.json

# Opcional: Credenciales directas por variable si no se usa archivo JSON
FB_COOKIE_C_USER=your_c_user_id
FB_COOKIE_XS=your_xs_token
FB_COOKIE_DATR=your_datr_token
FB_COOKIE_SB=your_sb_token

# ID del grupo de Facebook a scrapear
FB_GROUP_ID=123456789012345

# Ruta del binario de Chromium (opcional, usa el del sistema por defecto)
PLAYWRIGHT_CHROMIUM_PATH=

# Modo headless (true/false)
HEADLESS=true

# Directorios de salida
SCRAPE_OUTPUT_DIR=/tmp/facebook_scrapes
REPORT_OUTPUT_DIR=./reports

# Textos y metadatos para generación de reportes PDF
REPORT_GROUP_NAME=Grupo de Facebook
REPORT_ENTITY_NAME=Entidad de Facebook
REPORT_OWNER_NAME=Gestor Titular
REPORT_ECOSYSTEM_NAME=Ecosistema Digital Asociado
